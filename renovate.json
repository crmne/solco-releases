{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>crmne/github-automation//renovate/default"],
  "description": "No tests run on pull requests here, so updates wait for review instead of merging on green.",
  "packageRules": [
    {
      "matchPackageNames": ["*"],
      "automerge": false
    }
  ],
  "vulnerabilityAlerts": {
    "automerge": false
  }
}
