{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>crmne/github-automation//renovate/default"],
  "description": "CI here does not cover what updates can break, so they wait for review instead of merging on green.",
  "packageRules": [
    {
      "matchPackageNames": ["*"],
      "automerge": false
    }
  ],
  "vulnerabilityAlerts": {
    "automerge": false
  }
}
